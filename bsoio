#!/usr/bin/env python3
"""Small administrator command for the BoltSnip license database."""

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "licensing"))
from server import main


if __name__ == "__main__":
    database = os.environ.get("BOLTSNIP_DB", str(Path.home() / "boltsnip" / "licenses.db"))
    arguments = sys.argv[1:] or ["list"]
    aliases = {"c": "create", "s": "serve", "d": "diy"}
    arguments[0] = aliases.get(arguments[0], arguments[0])
    main(["--db", database] + arguments)
